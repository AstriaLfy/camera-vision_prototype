# Salin file ini jadi `.env` lalu sesuaikan. `.env` jangan di-commit
# (sudah masuk .gitignore).
#
# Semua variabel di bawah OPSIONAL: tanpa `.env` pun layanan jalan dengan
# default yang sama persis dengan perilaku lama.

# Mode layanan CV:
#   indicator_only  (default) indikator rule-based saja, tanpa model terlatih
#   model           memakai model terlatih -- BELUM diimplementasikan, endpoint
#                   /api/v1/screening/analyze mengembalikan 501
#   off             tidak menjalankan CV sama sekali: data_pendukung selalu
#                   kosong, input antropometri & status LiLA tetap diproses
CV_MODE=indicator_only

# Batas ukuran upload foto, dalam MB. Default 12.
MAX_UPLOAD_MB=12

# Sisi terpanjang foto dalam piksel; lebih besar otomatis di-downscale.
# Default 2000 px.
MAX_DIMENSION_PX=2000

# Origin yang diizinkan CORS. Default KOSONG = ketat, tidak ada origin asing
# yang boleh memanggil API dari browser. Format: JSON array ATAU daftar
# dipisah koma. JANGAN pakai "*".
#   ALLOWED_ORIGINS=["https://app.example.com","https://admin.example.com"]
#   ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
ALLOWED_ORIGINS=

# Content-Type yang diterima untuk upload foto. Default jpeg/png saja.
# Format sama dengan ALLOWED_ORIGINS: JSON array ATAU daftar dipisah koma.
#   ALLOWED_UPLOAD_TYPES=["image/jpeg","image/png"]
# Kosong = kembali ke default (image/jpeg, image/jpg, image/png).
# ALLOWED_UPLOAD_TYPES=

# Ambang referensi untuk indikator visual (app/indicators.py). Default KOSONG
# = tidak ada ambang sama sekali: app/indicators.py deskriptif, tidak ada
# klasifikasi dan tidak ada ambang normal/abnormal di output.
#
# Setiap entri WAJIB punya `sumber` (asal angka: literatur/pedoman/dataset).
# Entri tanpa `sumber` DIABAIKAN saat dibaca (lihat app.indicators.muat_ambang).
# Format: JSON array of object.
#   AMBANG_INDIKATOR=[{"kunci":"hair_l","sumber":"pedoman X","bawah":10}]
# AMBANG_INDIKATOR=

# Path model FaceLandmarker. Default-nya sudah benar (models/face_landmarker.task
# di folder repo) jadi TIDAK PERLU diisi.
#
# PERINGATAN: app/pipeline.py masih membaca app/config.py::MODEL_PATH, bukan
# env var ini. Menimpa nilai di bawah hanya mengubah pelaporan /api/v1/health,
# bukan model yang dipakai pipeline. Biarkan tertutup sampai pipeline juga
# dibuat membaca settings.
# MODEL_PATH=/path/absolut/ke/face_landmarker.task

# ---------------------------------------------------------------------------
# Deploy (Docker + PostgreSQL + ngrok). Semua OPSIONAL. Nilai di bawah adalah
# default yang dipakai docker-compose.yml kalau barisnya dikosongkan.
# ---------------------------------------------------------------------------

# Koneksi database. Driver psycopg 3 -> skema URL `postgresql+psycopg://`.
# Host `db` = nama service Postgres di docker-compose.yml.
#
# PENTING: nilai user/password/db di sini harus SAMA dengan POSTGRES_* di
# bawah. Kalau mengubah POSTGRES_*, samakan di baris ini, ATAU kosongkan baris
# ini supaya docker-compose menurunkan DATABASE_URL otomatis dari POSTGRES_*.
DATABASE_URL=postgresql+psycopg://app:ganti-ini@db:5432/app

# Kredensial service Postgres. WAJIB diganti sebelum dipakai di luar mesin
# lokal. Placeholder "ganti-ini" ditulis sengaja supaya jelas belum diisi.
POSTGRES_USER=app
POSTGRES_PASSWORD=ganti-ini
POSTGRES_DB=app

#NGROK
NGROK_AUTHTOKEN=
NGROK_DOMAIN=jaws-hurler-unranked.ngrok-free.dev
PUBLIC_BASE_URL=https://jaws-hurler-unranked.ngrok-free.dev


# Jumlah worker uvicorn. Default 1. Naikkan sesuai jumlah CPU; tiap worker
# memuat model FaceLandmarker sendiri saat dipakai.
WEB_WORKERS=1

# Endpoint debug (/api/v1/debug-landmarks) hanya terdaftar bila true.
# Default false -- endpoint itu mengembalikan gambar berisi landmark dan tidak
# untuk produksi.
ENABLE_DEBUG_ENDPOINTS=false

# Mode lingkungan: dev | prod. Menentukan default dokumentasi interaktif.
APP_ENV=dev

# Dokumentasi interaktif (/docs, /redoc, /openapi.json).
#   kosong -> ikut APP_ENV (aktif di dev, mati di prod)
#   true   -> selalu aktif
#   false  -> selalu mati (disarankan saat API publik lewat ngrok)
# ENABLE_DOCS=false
